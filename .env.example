# ==========================================
# WYNN & REYA CONTAINER VERIFICATION SYSTEM
# AI INTEGRATION CONFIGURATION (.env.example)
# ==========================================

# 1. Database & Authentication
DATABASE_URL="file:./sqlite.db"
AUTH_SECRET="your-development-auth-secret-min-32-chars-long"

# 2. AI Provider Settings (Google Gemini Official SDK)
GEMINI_API_KEY="your-google-gemini-api-key-here"
AI_PROVIDER="google"
AI_MODEL="gemini-3.6-flash"

# 3. AI Execution Parameters
AI_REQUEST_TIMEOUT_MS=30000
AI_MAX_OUTPUT_TOKENS=2048
AI_TEMPERATURE=0.2

# 4. Concurrency & Queue Control
MAX_AI_CONCURRENCY=3

# 5. Rate Limits (Server-side Enforcement)
AI_PROCESSING_RATE_LIMIT_MAX=10
AI_PROCESSING_RATE_LIMIT_WINDOW_MS=60000
AI_FOLLOWUP_RATE_LIMIT_MAX=5
AI_FOLLOWUP_RATE_LIMIT_WINDOW_MS=60000

# 6. File Storage & Restriction Boundaries
MAX_UPLOAD_SIZE_BYTES=10485760
UPLOAD_STORAGE_DIR="./storage/uploads"
